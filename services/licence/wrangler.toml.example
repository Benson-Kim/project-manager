name = "modulus-licence"
main = "src/worker.ts"
compatibility_date = "2026-11-01"

[[d1_databases]]
binding = "DB"
database_name = "modulus-licence"
database_id = "set-from-wrangler-d1-create"
migrations_dir = "migrations"

[triggers]
crons = ["0 3 * * *"]

[vars]
SIGNING_KID = "2026-11"
MAIL_FROM = "Modulus <trial@example.com>"
