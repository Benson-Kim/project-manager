# Copy to .env for local development. NEVER commit real secrets —
# production values live in the host's .env, CI values in GitHub Actions secrets.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ProjectManager
# The app's own SQL login (ADR-0033): EXECUTE on the stored procedures, no table
# access. scripts/db-apply.sh creates it (or resets its password) from these two;
# docker-compose hands the same pair to the app container as DB_USER/DB_PASSWORD.
DB_APP_USER=pm_web
DB_APP_PASSWORD=changeMe_App_Str0ng!
# What the app connects with outside Docker (npm run dev / start): the same login.
DB_USER=pm_web
DB_PASSWORD=changeMe_App_Str0ng!
# The SQL Server container's sa password. scripts/db-apply.sh, backup.sh and
# restore*.sh connect with it (DB_ADMIN_USER/DB_ADMIN_PASSWORD override it for a
# server that is not this container); the app never does.
MSSQL_SA_PASSWORD=changeMe_Str0ng!
# Auth.js secret - REQUIRED, >= 32 random bytes. Generate with:
#   openssl rand -base64 32
# Production/CI: masked CI/CD variable, never in the repo.
AUTH_SECRET=generate-me-with-openssl-rand-base64-32
# The origin users type in the browser (scheme + host + port, no path). Auth.js
# builds its callback and redirect URLs from it, never from the Host header
# (ADR-0032). Behind a reverse proxy this is the public https origin.
AUTH_URL=http://localhost:3000
# Number of trusted reverse-proxy hops in front of Next.js.
#   0 (default) = direct / docker-compose / local dev — XFF is ignored; all
#                 unauthenticated direct clients share the "unknown" bucket,
#                 which is acceptable because the login port is not internet-
#                 facing in this topology; the login window is then 60/min shared
#                 (ADR-0031) and the per-user lockout is the primary control.
#   1           = one Nginx/Caddy/ALB in front — the proxy appends the real
#                 client IP; we take the entry immediately left of its append.
# Never set above the number of proxy hops you actually control.
TRUSTED_PROXY_COUNT=0
# Per-user, per-minute limits (ADR-0031); 0 turns one off.
RATE_LIMIT_ACTIONS_PER_MINUTE=240
RATE_LIMIT_EXPORTS_PER_MINUTE=20
# Set to "true" when using the bundled docker-compose stack whose SQL Server
# container uses a self-signed certificate.  Leave unset (or "false") for any
# environment that presents a trusted CA certificate.
TRUST_SERVER_CERT=true
# Initial admin password for seeding: scripts/db-apply.sh hashes it with
# argon2id at seed time (no hash committed); admin must change it on first login.
SEED_ADMIN_PASSWORD=changeMe_Initial_Admin!

# Web Push VAPID configuration. Generate once with:
#   npx web-push generate-vapid-keys --json
# Keep the private key and dispatch token in masked production/CI variables.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.test
# Generate with: openssl rand -base64 32
ALERT_PUSH_DISPATCH_TOKEN=

# Attachments (ADR-0026). Absolute folder outside the web root for uploaded
# bytes; empty = <working directory>/uploads (gitignored). Docker uses the
# /app/uploads volume; the desktop sets it from machine.json. Back it up with
# the database (scripts/backup.sh tars it).
UPLOADS_DIR=
# Uploaded megabytes each project may hold (project-less records share one bucket).
UPLOADS_QUOTA_MB_PER_PROJECT=2048
# Free megabytes an upload must leave on the uploads disk (0 = no check). This,
# not the quota, keeps uploads from filling the disk the database also uses.
UPLOADS_MIN_FREE_MB=2048
