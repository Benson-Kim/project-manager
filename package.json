{
  "name": "project-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile-first rebuild of the Access project-management system (Next.js + SQL Server, stored-procedure-only data access)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "mssql": "^12.7.2",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.2",
    "@radix-ui/react-dialog": "^1.1.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mssql": "^9.1.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0",
    "@axe-core/playwright": "^4.11.2",
    "@vitest/coverage-v8": "^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
